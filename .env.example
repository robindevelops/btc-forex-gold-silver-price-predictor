# Environment Variables for Crypto-Forex Prediction System
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# FRED API Key (free at https://fred.stlouisfed.org/docs/api/api_key.html)
# Used for: Federal Funds Rate, 10Y Treasury Yield
FRED_API_KEY=your_fred_api_key_here

# NewsAPI Key (free at https://newsapi.org/register)
# Used for: News headline sentiment analysis
NEWSAPI_KEY=your_newsapi_key_here
