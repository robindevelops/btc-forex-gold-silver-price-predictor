# Environment variables (optional).
#
# The pipeline needs NO API keys: Yahoo Finance (yfinance) and the alternative.me Fear & Greed index are free and
# unauthenticated. This file exists only for optional runtime settings; copy it to .env if you need any of them.
# NEVER commit .env to version control.

# Silence TensorFlow start-up logging (0 = all, 3 = errors only)
TF_CPP_MIN_LOG_LEVEL=3
