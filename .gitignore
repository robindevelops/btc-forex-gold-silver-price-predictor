# Environments
venv/
.venv/
env/
.env/
.env

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Mac OS X
.DS_Store

# Jupyter Notebook
.ipynb_checkpoints

# VS Code
.vscode/

# Project specific
# data/raw/ (the frozen 2018-01 → 2026-09-12 download behind every reported result, ~1 MB) and data/models/ (the trained models and
# scalers, ~2 MB) ARE versioned, so a fresh clone reproduces the reported results exactly — Yahoo revises history and rolls futures
# contracts, so a re-download would not. data/processed/ is rebuilt from data/raw by `make preprocess`; data/raw_live/ is the daily
# live download.
data/raw_live/
data/processed/*
!data/processed/.gitkeep

# Testing and coverage
.pytest_cache/
htmlcov/
.coverage

# Build and distribution
*.egg-info/
dist/
build/

# Types
.mypy_cache/

# Logs
*.log
!data/models/model_status.json
!data/models/.gitkeep

# Local caches created by libraries
catboost_info/
Library/
.keras/
.matplotlib/
logs/

